<Window x:Class="WinTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WinTweaker.Views"
        xmlns:conv="clr-namespace:WinTweaker.Converters"
        Title="WinTweaker"
        Width="1180"
        Height="780"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1C1C1C"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <conv:BoolVisConverter x:Key="BoolVis" />
    <conv:BoolVisConverter x:Key="BoolVisInv" Invert="True" />

    <DataTemplate x:Key="CheckTweak">
      <CheckBox Margin="0,3,0,3"
                HorizontalAlignment="Stretch"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                IsEnabled="{Binding IsAvailable}"
                ToolTip="{Binding ToolTipText}">
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
      </CheckBox>
    </DataTemplate>

    <DataTemplate x:Key="ComboTweak">
      <StackPanel Margin="0,6,0,4" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding ToolTipText}">
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,4">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#1C1C1C" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                  <Setter Property="Foreground" Value="#A6A6A6" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ComboBox ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                  DisplayMemberPath="Label" />
      </StackPanel>
    </DataTemplate>

    <views:TweakTemplateSelector x:Key="TweakSelector"
                                 CheckTemplate="{StaticResource CheckTweak}"
                                 ComboTemplate="{StaticResource ComboTweak}" />

    <DataTemplate x:Key="CategoryCard">
      <Border Background="White" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8" Padding="14,12">
        <StackPanel>
          <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#1C1C1C" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8A8A8A" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="{Binding Description}" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Items}" ItemTemplateSelector="{StaticResource TweakSelector}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMatch}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="#F3F3F3">
      <TextBlock Text="WinTweaker" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
      <TextBlock Text="{Binding AvailabilityNote}" Margin="120,0,150,0" VerticalAlignment="Center" FontSize="11" Foreground="#6A6A6A" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource ChromeButton}" Command="{Binding AboutCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="About">
          <Path Stroke="#1C1C1C" StrokeThickness="1.2" Fill="Transparent" Data="M 8,3 C 5.5,1 2,2 2,5.5 C 2,8.5 8,13 8,13 C 8,13 14,8.5 14,5.5 C 14,2 10.5,1 8,3" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Click="Menu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Menu">
          <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Undo last apply" Command="{Binding UndoCommand}" />
              <MenuItem Header="Restart Explorer" Command="{Binding RestartExplorerCommand}" />
              <Separator />
              <MenuItem Header="About" Command="{Binding AboutCommand}" />
              <MenuItem Header="Exit" Command="{Binding CloseCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
          <StackPanel>
            <Border Width="14" Height="1.4" Background="#1C1C1C" Margin="0,1" />
            <Border Width="14" Height="1.4" Background="#1C1C1C" Margin="0,1" />
            <Border Width="14" Height="1.4" Background="#1C1C1C" Margin="0,1" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource CloseButton}" Command="{Binding CloseCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0,0 L 9,9 M 9,0 L 0,9" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="22,6,22,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#FFF4CE" BorderBrush="#E6D48A" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10"
              Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Restart as admin" Command="{Binding ElevateCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" />
          <TextBlock Text="Not running as administrator. Machine-wide settings will fail until this window is elevated." TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Welcome" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Tweaks for Windows 7, 10 and 11. Nothing is written until Apply." Style="{StaticResource PageSub}" />
            <Border Background="White" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Detected" Foreground="#6A6A6A" FontSize="12" />
                <TextBlock Text="{Binding Os.Caption}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,12" />
                <CheckBox Content="Create a restore point before writing anything" IsChecked="{Binding CreateRestorePoint}" Margin="0,4" />
                <CheckBox Content="Restart Explorer when finished" IsChecked="{Binding RestartExplorer}" Margin="0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="#5E5E5E" FontSize="12" Margin="0,10,0,0"
                           Text="A restore point needs System Protection on the system drive. If it cannot be created, Apply continues and the log says why. Undo last apply is in the menu." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="1">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
            <TextBlock Grid.Row="1" Text="Preinstalled apps to remove. Windows 7 has no Store apps, so this page stays empty there." Style="{StaticResource PageSub}" />
            <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="Windows 7 does not use Store apps. There is nothing to remove here."
                       Visibility="{Binding AppsSupported, Converter={StaticResource BoolVisInv}}" />
            <DockPanel Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding AppsSupported, Converter={StaticResource BoolVis}}">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                <Button Content="Select common" Command="{Binding SelectCommonCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Clear" Command="{Binding ClearAppsCommand}" Style="{StaticResource SecondaryButton}" />
                <Grid Width="240" HorizontalAlignment="Right" DockPanel.Dock="Right">
                  <TextBox Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" />
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#6A6A6A" IsHitTestVisible="False" />
                </Grid>
              </DockPanel>
              <Border Background="White" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="8,4" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMatch}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" ToolTip="{Binding Description}">
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </Grid>
        </Grid>

        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="2">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="System Tweaks" Style="{StaticResource PageTitle}" />
            <TextBlock Grid.Row="1" Style="{StaticResource PageSub}"
                       Text="Select which tweaks you want to apply to your system, hover over settings for more information" />
            <DockPanel Grid.Row="2" Margin="0,14,0,12" LastChildFill="False">
              <Button Content="Select Default Settings" Command="{Binding SelectDefaultCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
              <Button Content="Select Last Used Settings" Command="{Binding SelectLastCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
              <Button Content="Clear Selection" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" />
              <Grid Width="230" DockPanel.Dock="Right">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#6A6A6A" IsHitTestVisible="False" />
                <TextBlock Text="Search setting" Margin="28,0,0,0" VerticalAlignment="Center" Foreground="#9A9A9A" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchText}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DockPanel>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftColumn}" ItemTemplate="{StaticResource CategoryCard}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Margin" Value="0,0,0,12" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVisibleItems}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding MiddleColumn}" ItemTemplate="{StaticResource CategoryCard}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Margin" Value="0,0,0,12" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVisibleItems}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <ItemsControl Grid.Column="4" ItemsSource="{Binding RightColumn}" ItemTemplate="{StaticResource CategoryCard}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Margin" Value="0,0,0,12" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVisibleItems}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="3">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="190" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Review" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding ReviewSubtitle}" Style="{StaticResource PageSub}" />
            </StackPanel>
            <Border Grid.Row="1" Background="White" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8" Margin="0,14,0,10" Padding="12">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReviewItems}" />
              </ScrollViewer>
            </Border>
            <TextBox Grid.Row="2" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" Background="#FAFAFA" BorderBrush="#E4E4E4" Padding="8"
                     VerticalScrollBarVisibility="Auto" TextChanged="Log_TextChanged" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" BorderBrush="#E6E6E6" BorderThickness="0,1,0,0" Background="#F3F3F3">
      <Grid Margin="22,0">
        <Button Content="←  Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="88" />
        <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource DotButton}"
                      Command="{Binding DataContext.GoPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Index}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
